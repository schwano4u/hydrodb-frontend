{
  "name": "hydrodb-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:watch": "vite build --watch",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:browser": "NODE_EXTRA_CA_CERTS=../staging/test/hydrodb-empty-test/tls/ca.crt playwright test",
    "test:browser:isolated": "NODE_EXTRA_CA_CERTS=../staging/test/hydrodb-empty-test/tls/ca.crt node browser/isolated.mjs",
    "deploy:test": "npm run build && bash deploy/test.sh"
  },
  "dependencies": {
    "dockview": "8.9.1",
    "echarts": "6.1.0",
    "hyparquet-writer": "^0.18.0",
    "lossless-json": "4.3.4",
    "ol": "10.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
