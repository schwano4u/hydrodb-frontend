{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://{$HYDRODB_PUBLIC_HOST}:8443 {
	tls {$HYDRODB_TLS}
	request_body {
		max_size 32MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /assets/* {
		root * /srv/hydrodb-frontend
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
		}
		file_server
	}
	@frontend path / /index.html /hydrodb.svg
	handle @frontend {
		root * /srv/hydrodb-frontend/current
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://tile.openstreetmap.org; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Cache-Control no-cache
		}
		file_server
	}
	handle {
		reverse_proxy app:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	log {
		output stdout
		format json
	}
}
